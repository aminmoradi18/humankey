# names only, no values. Copy to .env and fill in.
# LLM: Meterless Runtime (Nightshift Console URL + token) is the primary provider.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Development backend (OpenAI-compatible): OpenRouter free Nemotron models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter          # meterless | openrouter | ollama | custom | replay
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Local open-weights Nemotron (ollama), comma-separated fallbacks allowed
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
# Any other OpenAI-compatible provider
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
# Zetaris (local Docker install)
ZETARIS_LOGIN_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_USER=
ZETARIS_PASSWORD=
ERP_DB_PASSWORD=
ZETARIS_MODE=live                # live | snapshot
DEVICE=emulator                  # serial | emulator
SAMPLE_MODE=false                # true: no Zetaris, no LLM, no credentials (replays snapshots)
